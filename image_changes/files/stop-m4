#!/bin/sh

RPROC="/sys/class/remoteproc/remoteproc0"

if [ ! -d "$RPROC" ]; then
    echo "Error: remoteproc0 not found"
    exit 1
fi

STATE="$(cat "$RPROC/state")"

if [ "$STATE" = "offline" ]; then
    echo "M4 is already stopped"
    exit 0
fi

echo stop > "$RPROC/state"

echo "M4 state: $(cat "$RPROC/state")"